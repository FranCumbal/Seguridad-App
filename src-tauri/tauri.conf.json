{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Seguridad App",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$APPDATA/*", "$APPDATA/**", "$DOCUMENT/*", "$DOCUMENT/**"]
      },
      "dialog": { "all": true },
      "notification": { "all": true },
      "window": { "all": true },
      "shell": { "open": true },
      "http": {
        "all": true,
        "scope": ["http://localhost:3001/**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.empresa.seguridadapp",
      "icon": [
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Seguridad App — Sistema de Entrevistas",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "decorations": true
      }
    ]
  }
}
