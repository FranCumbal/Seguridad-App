# ==============================================================
#  SEGURIDAD APP — Variables del Servidor
#  Copiar como: server/.env
# ==============================================================

# ---- BASE DE DATOS SQL Server Express ----
# FORMATO CORRECTO para Prisma con instancia nombrada:
# usar  instance=SQLEXPRESS  en lugar de  localhost\SQLEXPRESS
DATABASE_URL="sqlserver://localhost;instance=SQLEXPRESS;database=SEGURIDADAPP;integratedSecurity=true;encrypt=true;trustServerCertificate=true"

# ---- SERVIDOR EXPRESS ----
PORT=3001
NODE_ENV=development

# ---- JWT ----
JWT_SECRET=prompt_maestro_jwt_secret_super_seguro_2024
JWT_EXPIRES_IN=8h

# ---- UPLOADS ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
