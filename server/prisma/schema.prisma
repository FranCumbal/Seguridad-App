generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  nombre        String   @db.VarChar(150)
  apellido      String   @db.VarChar(150)
  rol           String   @default("ENTREVISTADOR") @db.VarChar(50)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relaciones
  sesiones      Sesion[]
  auditoria     Auditoria[]
  entrevistas   Entrevista[]

  @@map("usuarios")
}

model Sesion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  @@map("sesiones")
}

model Entrevistador {
  id                    Int      @id @default(autoincrement())
  nombre_completo       String   @db.VarChar(200)
  cargo                 String   @db.VarChar(150)
  fotografia            String?  @db.VarChar(500)
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  entrevistas_asignadas EntrevistaEntrevistador[]
  @@map("entrevistadores")
}

model Entrevista {
  id                      Int      @id @default(autoincrement())
  codigo                  String   @unique @db.VarChar(50)
  usuarioId               Int?     
  estado                  String   @default("EN_PROCESO") @db.VarChar(50)
  observaciones_iniciales String?  @db.Text
  fecha_entrevista        DateTime @default(now())
  
  // --- NUEVOS CAMPOS DEL MÓDULO FAMILIA ---
  conviveCon              String?  @db.VarChar(500) // Guardará el arreglo convertido a texto ej: "Padres,Hermanos"
  calificacionFamilia     String?  @db.VarChar(100) // Guardará "Unida", "Estable", etc.
  // ----------------------------------------

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Relaciones
  usuario                 Usuario? @relation(fields: [usuarioId], references: [id])
  entrevistadores         EntrevistaEntrevistador[]
  datos_personales        DatosPersonales?
  familia                 Familia[]
  estudios                Estudio[]
  finanzas                Finanzas?
  historial_laboral       HistorialLaboral[]
  drogas_alcohol          DrogasAlcohol?
  judicial                Judicial?
  infiltracion            Infiltracion?
  validaciones            Validaciones?

  @@map("entrevistas")
}

model EntrevistaEntrevistador {
  id              Int           @id @default(autoincrement())
  entrevistaId    Int
  entrevistadorId Int
  orden           Int           @default(1)
  entrevista      Entrevista    @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  entrevistador   Entrevistador @relation(fields: [entrevistadorId], references: [id])
  @@unique([entrevistaId, entrevistadorId])
  @@map("entrevista_entrevistadores")
}

model DatosPersonales {
  id                Int        @id @default(autoincrement())
  entrevistaId      Int        @unique
  cedula            String     @db.VarChar(15)
  libreta_militar   String?    @db.VarChar(50)
  nombres           String     @db.VarChar(150)
  apellidos         String     @db.VarChar(150)
  fecha_nacimiento  DateTime
  edad              Int?
  estado_civil      String     @db.VarChar(50)
  genero            String     @db.VarChar(50)
  lugar_nacimiento  String?    @db.VarChar(200)
  provincia         String?    @db.VarChar(100)
  ciudad            String?    @db.VarChar(100)
  barrio_parroquia  String?    @db.VarChar(150)
  direccion         String?    @db.Text
  estado_salud      String?    @db.VarChar(50)
  telefono_fijo     String?    @db.VarChar(20)
  celular           String     @db.VarChar(20)
  correo            String?    @db.VarChar(255) 
  area_trabajo      String?    @db.VarChar(100)
  cargo_postula     String?    @db.VarChar(200)
  fotografia        String?    @db.VarChar(500)

  entrevista        Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("datos_personales")
}

model Familia {
  id              Int        @id @default(autoincrement())
  entrevistaId    Int
  tipo_parentesco String     @db.VarChar(100)
  nombres         String?    @db.VarChar(200) // <-- CAMBIADO A OPCIONAL (?)
  edad            Int?
  ocupacion       String?    @db.VarChar(200)
  lugar_trabajo   String?    @db.VarChar(200)
  celular         String?    @db.VarChar(20)
  observaciones   String?    @db.Text
  entrevista      Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  @@map("familia")
}

model Estudio {
  id              Int        @id @default(autoincrement())
  entrevistaId    Int
  nivel           String     @db.VarChar(100)
  institucion     String     @db.VarChar(200)
  titulo_obtenido String?    @db.VarChar(200)
  estado          String?    @db.VarChar(50)
  ciudad          String?    @db.VarChar(100)
  verificado      Boolean    @default(false)
  observaciones   String?    @db.Text
  entrevista      Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("estudios")
}

model Finanzas {
  id                         Int        @id @default(autoincrement())
  entrevistaId               Int        @unique
  ingresos_mensuales         Decimal?   @db.Decimal(10, 2)
  egresos_mensuales          Decimal?   @db.Decimal(10, 2)
  tiene_bienes_inmuebles     Boolean    @default(false)
  tiene_vehiculos            Boolean    @default(false)
  tiene_creditos             Boolean    @default(false)
  tiene_deudas_personales    Boolean    @default(false)
  tiene_reportes_negativos   Boolean    @default(false)
  observaciones              String?    @db.Text
  entrevista                 Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  // Relaciones 1-a-Muchos
  bienes_inmuebles           BienInmueble[]
  vehiculos                  Vehiculo[]
  creditos                   Credito[]
  deudas_personales          DeudaPersonal[]
  reportes_negativos         ReporteNegativo[]

  @@map("finanzas")
}

model BienInmueble {
  id          Int      @id @default(autoincrement())
  finanzasId  Int
  tipo        String   @db.VarChar(100)
  valor       Decimal  @db.Decimal(10, 2)
  finanzas    Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_bienes")
}

model Vehiculo {
  id          Int      @id @default(autoincrement())
  finanzasId  Int
  tipo        String   @db.VarChar(50)
  placa       String   @db.VarChar(20)
  modelo      String   @db.VarChar(100)
  finanzas    Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_vehiculos")
}

model Credito {
  id          Int      @id @default(autoincrement())
  finanzasId  Int
  entidad     String   @db.VarChar(200)
  monto       Decimal  @db.Decimal(10, 2)
  finanzas    Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_creditos")
}

model DeudaPersonal {
  id          Int      @id @default(autoincrement())
  finanzasId  Int
  detalle     String   @db.Text
  monto       Decimal  @db.Decimal(10, 2)
  finanzas    Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_deudas")
}

model ReporteNegativo {
  id          Int      @id @default(autoincrement())
  finanzasId  Int
  detalle     String   @db.Text
  monto       Decimal  @db.Decimal(10, 2)
  finanzas    Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_reportes")
}

model HistorialLaboral {
  id                         Int                  @id @default(autoincrement())
  entrevistaId               Int                  @unique
  medio_vacante              String?              @db.VarChar(100)
  acto_ilicito               Boolean              @default(false)
  detalle_grave              String?              @db.Text
  observaciones              String?              @db.Text
  entrevista                 Entrevista           @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  experiencias               ExperienciaLaboral[]

  @@map("historial_laboral")
}

model ExperienciaLaboral {
  id                         Int              @id @default(autoincrement())
  historialLaboralId         Int
  empresa                    String           @db.VarChar(200)
  cargo                      String           @db.VarChar(200)
  fecha_inicio               DateTime
  fecha_fin                  DateTime?
  trabajo_actual             Boolean          @default(false)
  motivo_salida              String?          @db.Text
  salario                    Decimal?         @db.Decimal(10, 2)
  certificado_laboral        Boolean          @default(false)
  observaciones              String?          @db.Text
  historial_laboral          HistorialLaboral @relation(fields: [historialLaboralId], references: [id], onDelete: Cascade)

  @@map("experiencia_laboral")
}

model DrogasAlcohol {
  id                         Int        @id @default(autoincrement())
  entrevistaId               Int        @unique
  
  // Sección: Alcohol
  consume_alcohol            Boolean    @default(false)
  ultima_vez_alcohol         String?    @db.VarChar(100) // hoy, ayer, ultima semana, etc.
  bebida_preferencia         String?    @db.VarChar(100)
  frecuencia_alcohol         String?    @db.VarChar(100) // ocasional, en fiestas, frecuentemente
  inconvenientes_alcohol     Boolean    @default(false)  // inconvenientes personales/familiares
  dependencia_alcohol        Boolean    @default(false)  // dependencias de licor
  
  // Sección: Drogas Ilegales y Narcotráfico
  concepto_drogas            String?    @db.Text         // qué entiende por drogas ilegales
  consume_drogas             Boolean    @default(false)
  tipo_drogas                String?    @db.Text         // tipo de drogas si consumió
  involucrado_narcotrafico   Boolean    @default(false)
  propuestas_narcotrafico    Boolean    @default(false)
  entorno_drogas             Boolean    @default(false)  // familia o amigos dedicados a esto
  
  observaciones              String?    @db.Text
  entrevista                 Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("drogas_alcohol")
}

model Judicial {
  id                                 Int        @id @default(autoincrement())
  entrevistaId                       Int        @unique
  
  interpuesto_demandas               Boolean    @default(false)
  sido_demandado                     Boolean    @default(false)
  proceso_judicial                   Boolean    @default(false)
  
  detenciones                        Boolean    @default(false)
  observacion_detenciones            String?    @db.Text
  
  familiares_detenidos               Boolean    @default(false)
  observacion_familiares_detenidos   String?    @db.Text
  
  visitado_carcel                    Boolean    @default(false)
  observacion_visitado_carcel        String?    @db.Text
  
  ultima_verificacion_judicial       DateTime?
  
  concepto_margen_ley                String?    @db.Text
  vinculos_margen_ley                String?    @db.Text
  
  manipulado_armas                   Boolean    @default(false)
  motivo_armas                       String?    @db.VarChar(100) // Militar, Deportivo, etc.
  
  actividades_fuera_ley              Boolean    @default(false)
  propuestas_ilegales                Boolean    @default(false)
  entorno_ilegal_antecedentes        Boolean    @default(false)
  participacion_actos_ilegales       Boolean    @default(false)
  
  observaciones_generales            String?    @db.Text

  entrevista                         Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("judicial")
}

model Infiltracion {
  id                         Int        @id @default(autoincrement())
  entrevistaId               Int        @unique
  
  motivacion_ingreso         String?    @db.Text
  
  contactos_empresa          Boolean    @default(false)
  detalle_contactos          String?    @db.Text
  
  intencion_ilicitos         Boolean    @default(false)
  acuerdo_ilicitos           Boolean    @default(false)
  instrucciones_dano         Boolean    @default(false) // Se usa "dano" sin la "ñ" por seguridad en BD

  tiene_tatuajes             Boolean    @default(false)

  observaciones              String?    @db.Text
  nivel_riesgo               String     @default("BAJO") @db.VarChar(20)

  entrevista                 Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  tatuajes                   Tatuaje[]

  @@map("infiltracion")
}

model Validaciones {
  id                      Int        @id @default(autoincrement())
  entrevistaId            Int        @unique
  documentos_verificados  Boolean    @default(false)
  referencias_verificadas Boolean    @default(false)
  resultado_general       String     @default("PENDIENTE") @db.VarChar(50)
  calificacion            Int?
  recomendacion           String?    @db.Text
  observaciones_finales   String?    @db.Text
  aprobado_por            String?    @db.VarChar(200)
  fecha_validacion        DateTime?
  entrevista              Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  @@map("validaciones")
}

model Tatuaje {
  id             Int          @id @default(autoincrement())
  infiltracionId Int
  descripcion    String?      @db.Text
  fotografia     String?      @db.VarChar(500)
  infiltracion   Infiltracion @relation(fields: [infiltracionId], references: [id], onDelete: Cascade)

  @@map("tatuajes")
}

model Auditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  accion     String   @db.VarChar(200)
  tabla      String   @db.VarChar(100)
  registroId Int?
  datos      String?  @db.Text
  ip         String?  @db.VarChar(50)
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  @@map("auditoria")
}