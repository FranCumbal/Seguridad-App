generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  email         String       @unique
  password_hash String
  nombre        String
  apellido      String
  rol           String       @default("ENTREVISTADOR")
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relaciones
  sesiones      Sesion[]
  auditoria     Auditoria[]
  entrevistas   Entrevista[]

  @@map("usuarios")
}

model Sesion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  @@map("sesiones")
}

model Entrevistador {
  id                    Int                       @id @default(autoincrement())
  nombre_completo       String
  cargo                 String
  fotografia            String?
  activo                Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  entrevistas_asignadas EntrevistaEntrevistador[]
  @@map("entrevistadores")
}

model Entrevista {
  id                      Int      @id @default(autoincrement())
  codigo                  String   @unique
  usuarioId               Int?     
  estado                  String   @default("EN_PROCESO")
  observaciones_iniciales String?  
  fecha_entrevista        DateTime @default(now())
  
  // --- NUEVOS CAMPOS DEL MÓDULO FAMILIA ---
  conviveCon              String?  
  calificacionFamilia     String?  
  lugar_hermanos          String?
  // ----------------------------------------

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Relaciones
  usuario                 Usuario? @relation(fields: [usuarioId], references: [id])
  entrevistadores         EntrevistaEntrevistador[]
  datos_personales        DatosPersonales?
  familia                 Familia[]
  estudios                Estudio[]
  finanzas                Finanzas?
  historial_laboral       HistorialLaboral[]
  drogas_alcohol          DrogasAlcohol?
  judicial                Judicial?
  infiltracion            Infiltracion?
  validaciones            Validaciones?

  @@map("entrevistas")
}

model EntrevistaEntrevistador {
  id              Int           @id @default(autoincrement())
  entrevistaId    Int
  entrevistadorId Int
  orden           Int           @default(1)
  entrevista      Entrevista    @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  entrevistador   Entrevistador @relation(fields: [entrevistadorId], references: [id])
  @@unique([entrevistaId, entrevistadorId])
  @@map("entrevista_entrevistadores")
}

model DatosPersonales {
  id                Int        @id @default(autoincrement())
  entrevistaId      Int        @unique
  cedula            String     
  libreta_militar   String?    
  nombres           String     
  apellidos         String     
  fecha_nacimiento  DateTime
  edad              Int?
  estado_civil      String     
  genero            String     
  lugar_nacimiento  String?    
  provincia         String?    
  ciudad            String?    
  barrio_parroquia  String?    
  direccion         String?    
  estado_salud      String?    
  telefono_fijo     String?    
  celular           String     
  correo            String?    
  area_trabajo      String?    
  cargo_postula     String?    
  fotografia        String?    

  entrevista        Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("datos_personales")
}

model Familia {
  id              Int        @id @default(autoincrement())
  entrevistaId    Int
  tipo_parentesco String     
  nombres         String?    
  edad            Int?
  ocupacion       String?    
  lugar_trabajo   String?    
  celular         String?    
  observaciones   String?    
  entrevista      Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  @@map("familia")
}

model Estudio {
  id              Int        @id @default(autoincrement())
  entrevistaId    Int
  nivel           String     
  institucion     String     
  titulo_obtenido String?    
  estado          String?    
  ciudad          String?    
  verificado      Boolean    @default(false)
  observaciones   String?    
  entrevista      Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("estudios")
}

model Finanzas {
  id                       Int        @id @default(autoincrement())
  entrevistaId             Int        @unique
  ingresos_mensuales       Decimal?   
  egresos_mensuales        Decimal?   
  tiene_bienes_inmuebles   Boolean    @default(false)
  tiene_vehiculos          Boolean    @default(false)
  tiene_creditos           Boolean    @default(false)
  tiene_deudas_personales  Boolean    @default(false)
  tiene_reportes_negativos Boolean    @default(false)
  observaciones            String?    
  entrevista               Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  // Relaciones 1-a-Muchos
  bienes_inmuebles         BienInmueble[]
  vehiculos                Vehiculo[]
  creditos                 Credito[]
  deudas_personales        DeudaPersonal[]
  reportes_negativos       ReporteNegativo[]

  @@map("finanzas")
}

model BienInmueble {
  id         Int      @id @default(autoincrement())
  finanzasId Int
  tipo       String   
  valor      Decimal  
  finanzas   Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_bienes")
}

model Vehiculo {
  id         Int      @id @default(autoincrement())
  finanzasId Int
  tipo       String   
  placa      String   
  modelo     String   
  finanzas   Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_vehiculos")
}

model Credito {
  id         Int      @id @default(autoincrement())
  finanzasId Int
  entidad    String   
  monto      Decimal  
  finanzas   Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_creditos")
}

model DeudaPersonal {
  id         Int      @id @default(autoincrement())
  finanzasId Int
  detalle    String   
  monto      Decimal  
  finanzas   Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_deudas")
}

model ReporteNegativo {
  id         Int      @id @default(autoincrement())
  finanzasId Int
  detalle    String   
  monto      Decimal  
  finanzas   Finanzas @relation(fields: [finanzasId], references: [id], onDelete: Cascade)
  @@map("finanzas_reportes")
}

model HistorialLaboral {
  id                 Int                  @id @default(autoincrement())
  entrevistaId       Int                  @unique
  medio_vacante      String?              
  acto_ilicito       Boolean              @default(false)
  detalle_grave      String?              
  observaciones      String?              
  entrevista         Entrevista           @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  experiencias       ExperienciaLaboral[]

  @@map("historial_laboral")
}

model ExperienciaLaboral {
  id                 Int              @id @default(autoincrement())
  historialLaboralId Int
  empresa            String           
  cargo              String           
  fecha_inicio       DateTime
  fecha_fin          DateTime?
  trabajo_actual     Boolean          @default(false)
  motivo_salida      String?          
  salario            Decimal?         
  certificado_laboral Boolean         @default(false)
  observaciones      String?          
  historial_laboral  HistorialLaboral @relation(fields: [historialLaboralId], references: [id], onDelete: Cascade)

  @@map("experiencia_laboral")
}

model DrogasAlcohol {
  id                       Int        @id @default(autoincrement())
  entrevistaId             Int        @unique
  
  // Sección: Alcohol
  consume_alcohol          Boolean    @default(false)
  ultima_vez_alcohol       String?    
  bebida_preferencia       String?    
  frecuencia_alcohol       String?    
  inconvenientes_alcohol   Boolean    @default(false)  
  dependencia_alcohol      Boolean    @default(false)  
  
  // Sección: Drogas Ilegales y Narcotráfico
  concepto_drogas          String?    
  consume_drogas           Boolean    @default(false)
  tipo_drogas              String?    
  involucrado_narcotrafico Boolean    @default(false)
  propuestas_narcotrafico  Boolean    @default(false)
  entorno_drogas           Boolean    @default(false)  
  
  observaciones            String?    
  entrevista               Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("drogas_alcohol")
}

model Judicial {
  id                               Int        @id @default(autoincrement())
  entrevistaId                     Int        @unique
  
  interpuesto_demandas             Boolean    @default(false)
  sido_demandado                   Boolean    @default(false)
  proceso_judicial                 Boolean    @default(false)
  
  detenciones                      Boolean    @default(false)
  observacion_detenciones          String?    
  
  familiares_detenidos             Boolean    @default(false)
  observacion_familiares_detenidos String?    
  
  visitado_carcel                  Boolean    @default(false)
  observacion_visitado_carcel      String?    
  
  ultima_verificacion_judicial     DateTime?
  
  concepto_margen_ley              String?    
  vinculos_margen_ley              String?    
  
  manipulado_armas                 Boolean    @default(false)
  motivo_armas                     String?    
  
  actividades_fuera_ley            Boolean    @default(false)
  propuestas_ilegales              Boolean    @default(false)
  entorno_ilegal_antecedentes      Boolean    @default(false)
  participacion_actos_ilegales     Boolean    @default(false)
  
  observaciones_generales          String?    

  entrevista                       Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("judicial")
}

model Infiltracion {
  id                 Int        @id @default(autoincrement())
  entrevistaId       Int        @unique
  
  motivacion_ingreso String?    
  
  contactos_empresa  Boolean    @default(false)
  detalle_contactos  String?    
  
  intencion_ilicitos Boolean    @default(false)
  acuerdo_ilicitos   Boolean    @default(false)
  instrucciones_dano Boolean    @default(false) 

  tiene_tatuajes     Boolean    @default(false)

  observaciones      String?    
  nivel_riesgo       String     @default("BAJO") 

  entrevista         Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  tatuajes           Tatuaje[]

  @@map("infiltracion")
}

model Validaciones {
  id                      Int        @id @default(autoincrement())
  entrevistaId            Int        @unique
  documentos_verificados  Boolean    @default(false)
  referencias_verificadas Boolean    @default(false)
  resultado_general       String     @default("PENDIENTE") 
  calificacion            Int?
  recomendacion           String?    
  observaciones_finales   String?    
  aprobado_por            String?    
  fecha_validacion        DateTime?
  entrevista              Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)
  @@map("validaciones")
}

model Tatuaje {
  id             Int          @id @default(autoincrement())
  infiltracionId Int
  descripcion    String?      
  fotografia     String?      
  infiltracion   Infiltracion @relation(fields: [infiltracionId], references: [id], onDelete: Cascade)

  @@map("tatuajes")
}

model Auditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  accion     String   
  tabla      String   
  registroId Int?
  datos      String?  
  ip         String?  
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  @@map("auditoria")
}

model Configuracion {
  id                Int      @id @default(1)
  logo_izq_url      String?  
  logo_izq_opacidad Float    @default(0.35)
  logo_izq_visible  Boolean  @default(true)
  logo_der_url      String?  
  logo_der_opacidad Float    @default(0.35)
  logo_der_visible  Boolean  @default(true)
  color_corporativo String   @default("#1e3a5f")
  texto_footer      String   @default("SEGURIDAD GRUPO EMPRESARIAL ROJAS")
  updatedAt         DateTime @updatedAt
}